{
  "name": "spend-sentinel",
  "version": "0.1.0",
  "description": "Local-first SaaS spend & renewal tracking — Free tier. Track subscriptions, see spend, never miss a renewal.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sentinel": "./dist/interfaces/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/interfaces/cli/index.ts",
    "web": "tsx src/interfaces/web/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["saas", "spend-management", "finops", "subscription-tracking", "renewal-alerts"],
  "engines": { "node": ">=20" },
  "dependencies": {
    "commander": "^12.1.0",
    "csv-parse": "^5.5.6",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
